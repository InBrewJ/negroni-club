# =====================================================================
# Negroni Club — proxies https://nc.dryark.uk → 127.0.0.1:3300
# =====================================================================
# Two changes to your existing nginx.conf:
#
# 1) Add `nc.dryark.uk` to the existing port-80 redirect block's server_name
#    list (so HTTP requests to nc.dryark.uk get redirected to HTTPS).
#    e.g. change:
#        server_name thread babyhousecookbook ... dryark.uk urawizard.com;
#    to:
#        server_name thread babyhousecookbook ... dryark.uk urawizard.com nc.dryark.uk;
#
# 2) Append the server { } block below somewhere alongside your other 443
#    blocks (order doesn't matter — nginx picks by server_name).
#
# CERT NOTE
# ---------
# This block reuses /etc/letsencrypt/live/dryark.uk/fullchain.pem. That cert
# only covers dryark.uk and its existing SANs — it does NOT yet cover
# nc.dryark.uk. After DNS for nc.dryark.uk resolves to this host, run:
#
#     sudo certbot --nginx -d nc.dryark.uk
#
# certbot will either expand the existing cert or create a separate one and
# rewrite this block accordingly. WebAuthn requires a valid cert (the browser
# will refuse the registration ceremony otherwise).
# =====================================================================

server {
    listen 443 ssl;
    server_name nc.dryark.uk;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/dryark.uk/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dryark.uk/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    add_header X-Frame-Options       "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff"   always;
    add_header Referrer-Policy        "no-referrer-when-downgrade" always;

    location / {
        proxy_pass         http://127.0.0.1:3300;   # matches PORT in run-remote.sh
        proxy_http_version 1.1;
        proxy_buffering    off;
        proxy_read_timeout    90;
        proxy_connect_timeout 90;
        proxy_redirect        off;

        # WebAuthn / cookies need correct Host + scheme info.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port  443;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }
}

# If you don't already have it elsewhere, add this once at the http {} level
# (or below the global proxy_buffer_* lines at the top of your config):
#
# map $http_upgrade $connection_upgrade {
#     default upgrade;
#     ''      close;
# }
